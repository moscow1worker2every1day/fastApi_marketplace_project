# Скопируйте в .env.e2e и при необходимости поправьте порты.
# Compose: docker compose --env-file .env.e2e -f docker-compose.yml -f docker-compose.e2e.yml -p marketplace-e2e up --build -d
# Pytest читает те же URL из .env.e2e (см. tests/e2e/config.py).
#
# Порты смещены относительно dev-стека (8000/8001/8002, 5432/5434, 5672, 6379),
# чтобы e2e мог работать параллельно с обычным `docker compose up`.

# --- Compose substitution ---
USER_APP_EXTERNAL_HOST=0.0.0.0
USER_APP_EXTERNAL_PORT=18000
USER_APP_INTERNAL_HOST=0.0.0.0
USER_APP_INTERNAL_PORT=8000
USER_APP_RELOAD=False
USER_APP_WORKERS=1

USER_POSTGRES_USER=postgres
USER_POSTGRES_PASSWORD=postgres
USER_POSTGRES_HOST=0.0.0.0
USER_POSTGRES_PORT=15432
USER_POSTGRES_DB=postgres

PRODUCT_APP_EXTERNAL_HOST=0.0.0.0
PRODUCT_APP_EXTERNAL_PORT=18001
PRODUCT_APP_INTERNAL_HOST=0.0.0.0
PRODUCT_APP_INTERNAL_PORT=8001
PRODUCT_APP_RELOAD=False
PRODUCT_APP_WORKERS=1

PRODUCT_POSTGRES_HOST=0.0.0.0
PRODUCT_POSTGRES_PORT=15434
PRODUCT_POSTGRES_USER=user
PRODUCT_POSTGRES_PASSWORD=password
PRODUCT_POSTGRES_DB=products_e2e_db

RABBITMQ_USER=app_user
RABBITMQ_PASSWORD=app_password
E2E_RABBITMQ_PORT=5673
E2E_RABBITMQ_UI_PORT=15673
E2E_REDIS_PORT=6380

CART_APP_EXTERNAL_PORT=18002
CART_APP_EXTERNAL_HOST=0.0.0.0
CART_APP_INTERNAL_PORT=8002
CART_APP_INTERNAL_HOST=0.0.0.0

# --- Pytest (публикуемые host-порты) ---
USER_SERVICE_URL=http://localhost:18000
PRODUCT_SERVICE_URL=http://localhost:18001
CART_SERVICE_URL=http://localhost:18002
HTTP_CLIENT_TIMEOUT=15
E2E_HEALTH_TIMEOUT_SEC=120
E2E_HEALTH_POLL_INTERVAL_SEC=2
E2E_EVENTUAL_TIMEOUT_SEC=15
E2E_EVENTUAL_POLL_INTERVAL_SEC=0.5
