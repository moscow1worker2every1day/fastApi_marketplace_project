# Runtime env for cart_service container (compose env_file).

APP_HOST=0.0.0.0
APP_INTERNAL_PORT=8002
DEPLOY_VERSION=0.1.0

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_USER=app_user
RABBITMQ_PASSWORD=app_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
MQ_PRODUCT_EXCHANGE=Product
MQ_PRODUCT_ROUTING_KEY=product
MQ_CART_QUEUE=cart.product_events

PYTHONPATH=/code
DEBUG=False
