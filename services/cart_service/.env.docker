# docker-compose.yml — подстановка ${VAR} (порты)
CART_APP_EXTERNAL_PORT=8002
CART_APP_EXTERNAL_HOST=0.0.0.0
CART_APP_INTERNAL_PORT=8002
CART_APP_INTERNAL_HOST=0.0.0.0


# container runtime — попадает в контейнер через env_file
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

MQ_PRODUCT_ROUTING_KEY=Product

PYTHONPATH=.
DEBUG=False
