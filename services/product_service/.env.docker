# docker-compose.yml — подстановка ${VAR} (порты, healthcheck)
PRODUCT_APP_EXTERNAL_HOST=0.0.0.0
PRODUCT_APP_EXTERNAL_PORT=8001
PRODUCT_APP_INTERNAL_HOST=0.0.0.0
PRODUCT_APP_INTERNAL_PORT=8001

PRODUCT_POSTGRES_USER=user
PRODUCT_POSTGRES_PASSWORD=password
PRODUCT_POSTGRES_HOST=0.0.0.0
PRODUCT_POSTGRES_PORT=5434
PRODUCT_POSTGRES_DB=products_test_db

# container runtime — попадает в контейнер через env_file
PRODUCT_APP_RELOAD=True
PRODUCT_APP_WORKERS=1

DEPLOY_VERSION=0.0.1

LOG_LEVEL=INFO

RABBITMQ_USER=app_user
RABBITMQ_PASSWORD=app_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

MQ_PRODUCT_EXCHANGE=Product
MQ_PRODUCT_ROUTING_KEY=Product

PYTHONPATH=/code

MODE=TEST
