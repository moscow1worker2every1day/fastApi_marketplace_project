# Local development (pytest, uvicorn on host)

DEPLOY_VERSION=0.0.1
LOG_LEVEL=INFO

RABBITMQ_USER=app_user
RABBITMQ_PASSWORD=app_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

MQ_PRODUCT_EXCHANGE=Product
MQ_PRODUCT_ROUTING_KEY=Product

APP_NAME=API.Product_service
APP_INTERNAL_HOST=0.0.0.0
APP_INTERNAL_PORT=8001
APP_EXTERNAL_HOST=127.0.0.1
APP_EXTERNAL_PORT=8001
APP_RELOAD=True
APP_WORKERS=1

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=products_test_db

MODE=DEV
