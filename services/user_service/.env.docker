# docker-compose.yml — подстановка ${VAR} (порты, healthcheck)
USER_APP_EXTERNAL_HOST=0.0.0.0
USER_APP_EXTERNAL_PORT=8000
USER_APP_INTERNAL_HOST=0.0.0.0
USER_APP_INTERNAL_PORT=8000

USER_POSTGRES_USER=postgres
USER_POSTGRES_PASSWORD=postgres
USER_POSTGRES_HOST=0.0.0.0
USER_POSTGRES_PORT=5432
USER_POSTGRES_DB=postgres

# container runtime — попадает в контейнер через env_file
USER_APP_RELOAD=True
USER_APP_WORKERS=1

DEPLOY_VERSION=0.0.1

LOG_LEVEL=INFO

JWT_SECRET_KEY=MY_SECRET_KEY
RABBITMQ_URL=amqp://guest:guest@rabbitmq/

JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem

PYTHONPATH=/code

MODE=TEST
