# Local development (alembic, pytest, uvicorn on host)

DEPLOY_VERSION1=0.0.1
LOG_LEVEL=INFO

JWT_SECRET_KEY=MY_SECRET_KEY
RABBITMQ_URL=amqp://guest:guest@localhost/

JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem

APP_NAME=API.User_service
APP_INTERNAL_HOST=0.0.0.0
APP_INTERNAL_PORT=8000
APP_EXTERNAL_HOST=127.0.0.1
APP_EXTERNAL_PORT=8000
APP_RELOAD=True
APP_WORKERS=1

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=users_test_db

MODE=DEV
