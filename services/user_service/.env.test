# pytest / integration tests
LOG_LEVEL=INFO

JWT_SECRET_KEY=MY_SECRET_KEY
RABBITMQ_USER=app_user
RABBITMQ_PASSWORD=app_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://app_user:app_password@rabbitmq/

JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem

APP_NAME=API.User_service
CONTAINER_NAME=user_service
APP_INTERNAL_HOST=0.0.0.0
APP_INTERNAL_PORT=8000
APP_EXTERNAL_HOST=127.0.0.1
APP_EXTERNAL_PORT=8000
APP_RELOAD=False
APP_WORKERS=8
PYTHONPATH=/code

DEPLOY_VERSION=0.0.1

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=users_test_db

MODE=TEST

TEST_APP_HOST=localhost
TEST_APP_PORT=8000
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=password
